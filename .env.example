# ---------------------------------------------------------------------------
# Copy to .env and run `php artisan key:generate` before starting the app.
# Never commit .env — it is git-ignored. Set these values as environment
# variables on your hosting provider (Render, Heroku, etc.) in production.
# ---------------------------------------------------------------------------
APP_NAME="Training Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Public React/Vite app. Activation links and password reset links point here.
# Set this to the real SPA domain in production (no trailing slash).
FRONTEND_URL=http://localhost:5173

# Browser origins allowed to call this API. Include EVERY host that serves the
# SPA (apex + www + staging + local dev) or browsers will block the request.
# Leave empty or use * to allow any origin (Bearer-token auth, no cookies).
CORS_ALLOWED_ORIGINS=https://traininghubtz.co.tz,https://www.traininghubtz.co.tz,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Optional single regex for dynamic preview hosts, e.g.
# CORS_ALLOWED_ORIGIN_PATTERNS="#^https://[a-z0-9-]+\.vercel\.app$#"
CORS_ALLOWED_ORIGIN_PATTERNS=
CORS_SUPPORTS_CREDENTIALS=true
# How long (seconds) browsers may cache a preflight (OPTIONS) response.
CORS_MAX_AGE=600
SANCTUM_STATEFUL_DOMAINS=traininghubtz.co.tz,www.traininghubtz.co.tz,localhost:5173,127.0.0.1:5173,localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development defaults to SQLite so the app runs with zero setup.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=training
# DB_USERNAME=root
# DB_PASSWORD=
# For MySQL deployments set DB_CONNECTION=mysql and fill in the values above.

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# PesaPal v3 credentials (leave PESAPAL_MODE=sandbox while testing).
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_URL=https://pay.pesapal.com/v3
PESAPAL_MODE=sandbox

# Optional shared secret for POST /api/payment-callback. If set, callers must
# send an X-Callback-Token header with the same value.
PAYMENT_CALLBACK_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
